# Environment template for the OPEN//77 Docker deployment.
#
# Copy this file to `.env` (same folder as docker-compose.yml), or — when
# deploying with Dokploy / another PaaS — define these variables in the
# application's environment settings. docker-compose.yml forwards them to the
# container as-is.
#
#   cp .env.example .env
#   docker compose up -d

# REQUIRED. Platform licence key from https://open2077.net/account/keys
# (kept out of server.jsonc so that file stays safe to share).
# Without a key the server runs but cannot enrol in the public server list.
OP77_LICENSE_KEY=

# Public IP or DNS name of the host, e.g. 203.0.113.10. Fills the advertised
# game/download addresses and enables the resource download listener. Leave
# empty to keep the address configured in server.jsonc or by the Warden wizard.
OP77_PUBLIC_IP=

# Optional. MySQL connection string for durable characters/careers
# (resources with the database.access permission). Defaults to local file
# storage when empty.
OP77_DATABASE_CONNECTION=

# --- Optional configuration overrides (precedence: args > env > server.jsonc) --
# Any server.jsonc field can be overridden at runtime; dots become double
# underscores. Examples:
# OP77_CONFIG__NETWORK__MAXIMUMPLAYERS=32
# OP77_CONFIG__LOGGING__LEVEL=info
# OP77_CONFIG__WARDEN__LISTENURL=http://0.0.0.0:11780/